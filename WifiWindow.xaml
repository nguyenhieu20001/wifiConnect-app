<Window x:Class="WifiConnect.WifiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WifiConnect"
        Title="Wi-Fi 接続" Width="420" Height="620" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3" FontFamily="Yu Gothic UI" FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:SignalBarBrushConverter x:Key="BarBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 共通ボタン -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#005FB8" />
            <Setter Property="BorderBrush" Value="#005FB8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>

        <!-- 一覧の 1 行 -->
        <Style x:Key="NetworkItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="White" CornerRadius="6"
                                BorderBrush="#E5E5E5" BorderThickness="1" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F9FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#005FB8" />
                                <Setter TargetName="Bd" Property="Background" Value="#EEF5FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- ヘッダー -->
            <RowDefinition Height="Auto" />  <!-- 現在の接続 -->
            <RowDefinition Height="*" />     <!-- 一覧 -->
            <RowDefinition Height="Auto" />  <!-- 接続パネル -->
            <RowDefinition Height="Auto" />  <!-- ステータス -->
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="再スキャン"
                    Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" />
            <TextBlock Text="Wi-Fi" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 現在の接続 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E5E5E5"
                BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="DisconnectButton" DockPanel.Dock="Right" Content="切断"
                        Style="{StaticResource SecondaryButton}" Click="DisconnectButton_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="現在の接続" Foreground="#6B6B6B" FontSize="11" />
                    <TextBlock x:Name="CurrentSsidText" Text="—" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ネットワーク一覧 -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="接続可能なネットワーク"
                       Foreground="#6B6B6B" FontSize="11" Margin="2,0,0,6" />
            <ListBox x:Name="NetworkList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NetworkItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="NetworkList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:WifiNetworkItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 電波強度（4 本バー） -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Height="16" Margin="0,0,12,0">
                                <Rectangle Width="4" Height="5" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{Binding SignalBars, Converter={StaticResource BarBrush}, ConverterParameter=1}" />
                                <Rectangle Width="4" Height="8" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{Binding SignalBars, Converter={StaticResource BarBrush}, ConverterParameter=2}" />
                                <Rectangle Width="4" Height="12" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{Binding SignalBars, Converter={StaticResource BarBrush}, ConverterParameter=3}" />
                                <Rectangle Width="4" Height="16" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{Binding SignalBars, Converter={StaticResource BarBrush}, ConverterParameter=4}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Ssid}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Status" Text="{Binding StatusText}"
                                           FontSize="11" Foreground="#6B6B6B" />
                            </StackPanel>

                            <!-- 鍵アイコン（Segoe MDL2 Assets: Lock） -->
                            <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#6B6B6B" VerticalAlignment="Center"
                                       Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter TargetName="Status" Property="Foreground" Value="#0F7B0F" />
                                <Setter TargetName="Status" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 接続パネル（ネットワーク選択時のみ表示） -->
        <Border x:Name="ConnectPanel" Grid.Row="3" Background="White" CornerRadius="6"
                BorderBrush="#005FB8" BorderThickness="1" Padding="12" Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="SelectedSsidText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                <StackPanel x:Name="PasswordArea">
                    <TextBlock Text="パスワード（保存済みの場合は空欄でOK）"
                               Foreground="#6B6B6B" FontSize="11" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput" Padding="6,5" Margin="0,0,0,10"
                                 KeyDown="PasswordInput_KeyDown" />
                </StackPanel>

                <Button x:Name="ConnectButton" Content="接続" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True"
                         Visibility="Hidden" BorderThickness="0" Margin="0,0,0,6" />
            <TextBlock x:Name="StatusText" Foreground="#6B6B6B" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
